# ── Secrets ──────────────────────────────────────────
# Copy this file to secrets.env and fill in your values.
# secrets.env is gitignored and dockerignored — never commit real secrets.
#
# After creating secrets.env, run:  docker compose up
# ──────────────────────────────────────────────────────

# LLM API key (required — the app will not start without this).
# LLM_URL and LLM_KEY are consumed by BOTH the app service (chat) and the
# fidaa knowledge service (embeddings).
# LLM_URL=https://ai.mydomain.de/llm/v1
LLM_KEY=sk-your-key-here

# EMBEDDING_MODEL (optional — consumed by the fidaa knowledge service)
# OpenAI-compatible embedding model name
# EMBEDDING_MODEL=Qwen3-Embedding-4B

# USE_EMBED_INSTRUCTIONS (optional — consumed by the fidaa knowledge service)
# Instruction-aware embeddings improve retrieval quality by 1-5%.
# Embeddings without this prefix are still valid, but instruction-aware
# embeddings are recommended.
# USE_EMBED_INSTRUCTIONS=true

# ── Optional overrides ───────────────────────────────
# Postgres password — must match DATABASE_URL if you change it.
# POSTGRES_PASSWORD=change-me

# JWT signing key — auto-generated at startup if unset.
# Set this to persist user sessions across container restarts.
# CHAINLIT_AUTH_SECRET=

# ── Seed users (optional) ───────────────────────────
# Comma-separated list of email:password pairs.
# Users are created/updated on every startup (idempotent).
# SEED_USERS=alice@example.com:secret123,bob@example.com:anotherpass

# ── Admin panel (optional, https://<host>/admin-<ADMIN_SALT>) ──
# Random path suffix for URL obscurity: the panel URL becomes
# /admin-<ADMIN_SALT> (e.g. 7493 -> /admin-7493).
# Generate with:  python3 -c "import secrets; print(secrets.randbelow(10000))"
# Empty = panel disabled.
# ADMIN_SALT=
# Accounts allowed to log in to the admin panel, same
# email:password format as SEED_USERS. Empty = no admins,
# panel disabled. An email present in BOTH lists must use
# the identical password in both (both services re-seed it
# on every startup).
# ADMIN_USERS=david@example.com:adminpass
# HMAC key for the panel's session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = panel disabled.
# ADMIN_SESSION_SECRET=
