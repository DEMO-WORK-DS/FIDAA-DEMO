# ── Secrets ──────────────────────────────────────────
# Copy this file to secrets.env and fill in your values.
# secrets.env is gitignored and dockerignored — never commit real secrets.
#
# After creating secrets.env, run:  docker compose up
# ──────────────────────────────────────────────────────

# LLM API key (required — the app will not start without this)
# LLM_URL=https://ai.mydomain.de/llm/v1
LLM_KEY=sk-your-key-here

# EMBEDDING_MODEL (optional)
# OpenAI-compatible endpoint for embeddings
# EMBEDDING_MODEL=Qwen3-Embedding-4B

# USE_EMBED_INSTRUCTIONS (optional)
# Instruction-aware embeddings improve retrieval quality by 1-5%.
# Embeddings without this prefix are still valid, but instruction-aware embeddings are recommended.
# USE_EMBED_INSTRUCTIONS=true

# ── Optional overrides ───────────────────────────────
# Postgres password — must match DATABASE_URL if you change it.
# POSTGRES_PASSWORD=change-me

# JWT signing key — auto-generated at startup if unset.
# Set this to persist user sessions across container restarts.
# CHAINLIT_AUTH_SECRET=

# ── Seed users (optional) ───────────────────────────
# Comma-separated list of email:password pairs.
# Users are created/updated on every startup (idempotent).
# SEED_USERS=alice@example.com:secret123,bob@example.com:anotherpass
