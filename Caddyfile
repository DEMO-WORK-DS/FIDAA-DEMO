# The kimap.h2.de edge (unchanged since before 2026-09-18) terminates client
# TLS (GEANT default cert) and re-encrypts to the origin: the backend must
# speak TLS on :443 with a certificate covering fidaa.h2.de. We reuse the
# test service's self-signed cert - proven on this exact path 09-18..09-21
# (the TLS-only test service received traffic, so the origin leg is TLS, not
# plain HTTP; the earlier "plain HTTP on 443" assumption was wrong).
# Do NOT use auto-TLS here (hostless ":443" site => no cert => handshake
# failure => edge marks the backend down => 503 for everything).
:443 {
    tls /etc/caddy/certs/fidaa-cert.pem /etc/caddy/certs/fidaa-key.pem
    log {
        format json
    }
    reverse_proxy app:8000
}

:80 {
    log {
        format json
    }
    reverse_proxy app:8000
}
