# The h2 central IT edge (kihap.h2.de) terminates TLS for fidaa.h2.de
# (GEANT "runai" cert) and forwards PLAIN HTTP to this backend on port
# 443 - verified 2026-09-21 with a test service. Public port 80 stays
# filtered at the edge, so no Let's Encrypt is possible here:
#   :80  - plain HTTP; internal (LAN/VPN) access
#   :443 - PLAIN HTTP (no TLS!): the public fidaa.h2.de path. The edge
#          performs the TLS handshake, so Caddy must not expect one
#          ("tls internal" here made the edge mark us unhealthy -> 503).
:80 {
    reverse_proxy app:8000
}

:443 {
    reverse_proxy app:8000
}
