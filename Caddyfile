# The kimap.h2.de edge (unchanged since before 2026-09-18) terminates client
# TLS (GEANT default cert) and re-encrypts to the origin: the backend must
# speak TLS on :443 with a certificate covering fidaa.h2.de. We reuse the
# test service's self-signed cert - proven on this exact path 09-18..09-21
# (the TLS-only test service received traffic, so the origin leg is TLS, not
# plain HTTP; the earlier "plain HTTP on 443" assumption was wrong).
# Do NOT use auto-TLS here (hostless ":443" site => no cert => handshake
# failure => edge marks the backend down => 503 for everything).
:443 {
    tls /etc/caddy/certs/fidaa-cert.pem /etc/caddy/certs/fidaa-key.pem
    log {
        format json
    }
    # Admin-Panel (admin.py, uvicorn :8001): die ganze /admin*-Familie
    # geht an das Panel; es bedient selbst nur /admin-<ADMIN_SALT>
    # (Salt aus secrets.env = URL-Versteckung). Alle anderen Pfade zeigen
    # eine identische, aber nicht-funktionsfähige Tarn-Login-Page.
    # Alle übrigen Pfade gehen an die Chat-App.
    handle /admin* {
        reverse_proxy admin:8001
    }
    # MCP-Endpunkt (fidaa-Service, streamable-HTTP :8002): öffentliche
    # Freigabe der FIDAA-Wissensdatenbank unter /mcp — offen, ohne
    # Authentifizierung (siehe FIDAA-README, "Öffentlicher Endpunkt"; die
    # LLM-API bleibt damit weiterhin von außen unerreicht).
    # flush_interval -1: Response-Buffering abschalten, sonst staut sich
    # das SSE-Stream-Bein von streamable-HTTP.
    handle /mcp* {
        reverse_proxy fidaa:8002 {
            flush_interval -1
        }
    }
    # Tab-Favicon für die ganze Site (Chat-UI, Admin-Panel, MCP-Landing-Page):
    # Der vom Browser konventionell erfragte /favicon*-Pfad ist keine
    # Chainlit-Route (sonst antwortet der SPA-Catch-all mit der index.html),
    # daher liefert Caddy die staticischen public/-Icons selbst. Reihenfolge
    # ist relevant: die .ico-Variante kommt vor dem Wildcard, damit jede
    # Anfrage eine Datei mit passender Endung/Content-Type bekommt
    # (image/x-icon bzw. image/svg+xml — kein Format-/Namens-Mismatch).
    # Regenerieren bei Logo-Änderung:
    #   rsvg-convert -w 64 -h 64 public/favicon.svg -o /tmp/f64.png
    #   rsvg-convert -w 32 -h 32 public/favicon.svg -o /tmp/f32.png
    #   magick /tmp/f64.png /tmp/f32.png public/favicon.ico
    handle /favicon.ico {
        rewrite * /public/favicon.ico
        reverse_proxy app:8000
    }
    handle /favicon* {
        rewrite * /public/favicon.svg
        reverse_proxy app:8000
    }
    handle {
        reverse_proxy app:8000
    }
}

:80 {
    log {
        format json
    }
    handle /admin* {
        reverse_proxy admin:8001
    }
    # Wie auf :443: /mcp* geht an den fidaa-Server (streamable-HTTP);
    # nackte GETs ohne MCP-Session beantwortet er selbst mit der
    # mcp-landing.html-Infoseite.
    handle /mcp* {
        reverse_proxy fidaa:8002 {
            flush_interval -1
        }
    }
    # Wie auf :443: /favicon.ico -> .ico, übrige /favicon* -> .svg.
    handle /favicon.ico {
        rewrite * /public/favicon.ico
        reverse_proxy app:8000
    }
    handle /favicon* {
        rewrite * /public/favicon.svg
        reverse_proxy app:8000
    }
    handle {
        reverse_proxy app:8000
    }
}
